# Amplience hub to fetch content from, using the Content Delivery API.
AMPLIENCE_HUB_NAME=ampliencelabs

# Delivery key of the PDP Layout Configuration content item that holds the rules.
PDP_LAYOUT_RULES_KEY=config/pdp-layout

# How long the rules held in memory are fresh. Once stale, the next request is still
# served from memory and the rules are refreshed in the background. Defaults to 60.
PDP_LAYOUT_RULES_MAX_AGE_SECONDS=60
