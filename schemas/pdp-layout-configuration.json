{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/pdp-layout-configuration.json",
    "type": "object",
    "title": "PDP Layout Configuration",
    "description": "",
    "allOf": [
        {
            "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content"
        }
    ],
    "properties": {
        "rules": {
            "title": "Rules",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "criteria": {
                        "type": [
                            "object",
                            "boolean"
                        ]
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "result": {
                        "title": "Layout",
                        "allOf": [
                            {
                                "$ref": "http://bigcontent.io/cms/schema/v1/core#/definitions/content-link"
                            },
                            {
                                "properties": {
                                    "contentType": {
                                        "enum": [
                                            "https://example.com/pdp-layout.json"
                                        ]
                                    }
                                }
                            }
                        ]
                    }
                }
            },
            "ui:extension": {
                "name": "rules-array",
                "params": {
                    "fields": [
                        {
                            "name": "product.category",
                            "label": "Category",
                            "dataSource": "categories"
                        },
                        {
                            "name": "product.brand",
                            "label": "Brand",
                            "type": "string"
                        },
                        {
                            "name": "product.price",
                            "label": "Price",
                            "type": "number"
                        },
                        {
                            "name": "product.onSale",
                            "label": "On sale",
                            "type": "boolean"
                        },
                        {
                            "name": "product.sku",
                            "label": "Product",
                            "dataSource": "products"
                        }
                    ]
                }
            }
        }
    },
    "propertyOrder": [
        "rules"
    ]
}
